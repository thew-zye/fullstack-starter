{
  "name": "@app/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=source src/index.ts",
    "mcp": "tsx --conditions=source src/mcp/stdio.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx --conditions=source src/migrate.ts up",
    "db:migrate:down": "tsx --conditions=source src/migrate.ts down",
    "db:migrate:new": "node-pg-migrate create --migrations-dir migrations --migration-file-language sql",
    "migrate:prod": "node dist/migrate.js up"
  },
  "dependencies": {
    "@app/config": "*",
    "@app/shared": "*",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.16.0",
    "redis": "^6.3.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/pg": "^8.15.0",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.1.0",
    "tsx": "^4.20.0"
  }
}
